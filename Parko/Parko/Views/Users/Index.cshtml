@model IReadOnlyList<RegisteredUserViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-3">Registered users</h1>
        @if (TempData["Ok"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["Err"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @if (Model.Count == 0)
        {
            <p class="text-secondary mb-0">There are no registered users.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr><th>Username</th><th>Email</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td class="text-end">
                                    <form asp-action="Delete" method="post"
                                          onsubmit="return confirm('Delete the account for @user.UserName?');">
                                        <input type="hidden" name="id" value="@user.Id">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
