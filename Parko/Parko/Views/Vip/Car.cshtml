@model VipCarRecordEditViewModel
@{
    var isEditing = Model.Id != 0;
    ViewData["Title"] = isEditing ? "Edit VIP vehicle" : "Add VIP vehicle";
    var actionName = isEditing ? "EditCar" : "CreateCar";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">@(isEditing ? "Edit VIP vehicle" : "Add VIP vehicle")</h1>
                <form asp-action="@actionName" method="post" class="row g-3">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="ClientId" type="hidden" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Vehicle" class="form-label">License plate</label>
                        <input asp-for="Vehicle" class="form-control" />
                        <span asp-validation-for="Vehicle" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Save vehicle</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
