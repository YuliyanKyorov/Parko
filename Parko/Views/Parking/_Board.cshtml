@model List<ParkingSpace>
@{
    var cars = (List<Car>)ViewBag.Cars;
}
<div class="card">
    <h3>Spaces: @Model.Count(s => s.Current == null) free / @Model.Count(s => s.Current != null) occupied</h3>
    <div class="grid">
        @foreach (var s in Model)
        {
            var c = s.Current;
            if (c == null)
            {
                <div class="sp f"><b>@s.Id</b><br>VACANCY</div>
            }
            else
            {

                <div class="sp @(c.IsVip ? "v" : "o")"><b>@s.Id</b><br>@(c.IsVip ? "VIP " + c.Vehicle : "OCCUPIED")<br>Car @c.Id<br>@c.EntryTime.ToString("HH:mm")</div>
            }
        }
    </div>
</div>
<div class="card">
    <h3>Car (last 50)</h3><div class="sc">
    <table>
        <tr><th>Id</th><th>Vehicle</th><th>Model</th><th>Space</th><th>Entry time</th><th>Release time</th><th>Price</th><th></th></tr>
        @foreach (var c in cars)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Vehicle @(c.IsVip ? "⭐" : "")</td>
                <td>@c.Model</td>
                <td>@c.ParkingSpaceId</td>
                <td>@c.EntryTime</td>
                <td>@c.ReleaseTime</td>
                <td>@(c.UsedPoint ? "1 VIP" : c.Price.HasValue ? c.Price.Value.ToString("F2") + " €" : "")</td>
                <td>
                    @if (c.ReleaseTime == null)
                    {
                        <form asp-controller="Parking" asp-action="CheckOut" method="post" style="display:flex"><input type="hidden" name="id" value="@c.Id"><input name="simMinutes" type="number" min="0" placeholder="мин (тест)" style="width:90px"><button>Излизане</button></form>
                    }
                </td>
            </tr>
        }
    </table>
</div>
</div>
