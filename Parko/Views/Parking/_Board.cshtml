@model List<ParkingSpace>
@{
    var cars = (List<Car>)ViewBag.Cars;
}
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-4">
    <h2 class="h4 mb-3">Паркоместа: @Model.Count(s => s.Current == null) свободни / @Model.Count(s => s.Current != null) заети</h2>
    <div class="d-flex flex-wrap gap-3 mb-3" aria-label="Легенда за паркоместата">
      <span><span class="badge bg-success">&nbsp;</span> Свободно</span>
      <span><span class="badge bg-danger">&nbsp;</span> Заето</span>
      <span><span class="badge bg-warning">&nbsp;</span> VIP</span>
    </div>
    <div class="row row-cols-4 row-cols-sm-6 row-cols-md-8 row-cols-lg-10 g-2" aria-label="Състояние на паркоместата">
        @foreach (var s in Model)
        {
            var c = s.Current;
            var color = c == null
                ? "btn-success"
                : c.IsVip
                    ? "btn-warning"
                    : "btn-danger";
            if (c == null)
            {
                <div class="col">
                  <div class="btn @color w-100 h-100">
                    <span class="d-block">Място</span>
                    <span class="fw-semibold">@s.Id</span>
                    <span class="d-block">Свободно</span>
                  </div>
                </div>
            }
            else
            {
                <div class="col">
                  <div class="btn @color w-100 h-100">
                    <span class="d-block">Място</span>
                    <span class="fw-semibold">@s.Id</span>
                    <span class="d-block @(c.IsVip ? "text-dark" : "")">@(c.IsVip ? "VIP" : "Заето")</span>
                  </div>
                </div>
            }
        }
    </div>
  </div>
</div>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <h2 class="h4">Car (last 50)</h2>
    <div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <tr><th>Id</th><th>Vehicle</th><th>Model</th><th>Space</th><th>Entry time</th><th>Release time</th><th>Price</th><th></th></tr>
        @foreach (var c in cars)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Vehicle @(c.IsVip ? "⭐" : "")</td>
                <td>@c.Model</td>
                <td>@c.ParkingSpaceId</td>
                <td>@c.EntryTime</td>
                <td>@c.ReleaseTime</td>
                <td>@(c.UsedPoint ? "1 VIP" : c.Price.HasValue ? c.Price.Value.ToString("F2") + " €" : "")</td>
                <td>
                    @if (c.ReleaseTime == null)
                    {
                        <form asp-controller="Parking" asp-action="CheckOut" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@c.Id">
                            <input name="simMinutes" class="form-control form-control-sm" type="number" min="0" placeholder="мин (тест)" aria-label="Тестови минути">
                            <button type="submit" class="btn btn-primary btn-sm text-nowrap">Излизане</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>
</div>
  </div>
</div>
