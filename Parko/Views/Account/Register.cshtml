@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-primary mb-4">Създаване на акаунт</h1>
                <p class="text-secondary">Акаунтът за вход е отделен от VIP клиентския профил.</p>
                <form asp-action="Register" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    }
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-help" />
                        <div id="password-help" class="form-text">Поне 8 символа, с главна и малка буква, цифра и специален знак.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Регистрация</button>
                    <a asp-action="Login" class="btn btn-outline-secondary ms-2">Вече имате акаунт?</a>
                </form>
            </div>
        </div>
    </div>
</div>
