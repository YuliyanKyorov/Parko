@model List<VipCarRecord>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">VIP клиенти</h1>
            <a class="btn btn-primary" asp-action="Create">+ New VIP client</a>
        </div>
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["Ok"]</div>
        }
        @if (TempData["Err"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Err"]</div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th>Клиент</th><th>Vehicle</th><th>Model</th><th>Color</th><th>Year</th>
                        <th>Адрес</th><th>Град</th><th>Държава</th><th>Телефон</th><th>E-mail</th>
                        <th>Points</th><th>Charging (дни)</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        var c = v.Client!;
                        <tr>
                            <td>@c.FirstName @c.LastName</td><td>@v.Vehicle</td><td>@v.Model</td><td>@v.Color</td>
                            <td>@v.Year</td><td>@c.Address</td><td>@c.City</td><td>@c.Country</td><td>@c.Phone</td><td>@c.Email</td>
                            <td>@(c.VipPoint?.Points) / @VipPoint.Monthly</td><td>@(c.VipPoint?.ChargingDays)</td>
                            <td>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this VIP client and all associated VIP cars?');">
                                    <input type="hidden" name="clientId" value="@c.Id">
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
