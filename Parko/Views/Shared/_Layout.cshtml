<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Парко</title>
    <style>
            body {
                font: 15px system-ui,Arial;
                margin: 0;
                background: #f5f6f8;
                color: #1c2330
            }

            nav {
                background: #1d5fd1;
                padding: 10px 16px
            }

                nav a {
                    color: #fff;
                    margin-right: 16px;
                    text-decoration: none;
                    font-weight: 600
                }

            main {
                max-width: 1000px;
                margin: 12px auto;
                padding: 0 12px
            }

            .card {
                background: #fff;
                border: 1px solid #d9dde4;
                border-radius: 10px;
                padding: 12px;
                margin-bottom: 12px
            }

            input {
                padding: 7px;
                border: 1px solid #ccd;
                border-radius: 6px;
                margin: 3px
            }

            button {
                padding: 7px 12px;
                background: #1d5fd1;
                color: #fff;
                border: 0;
                border-radius: 6px;
                cursor: pointer
            }

            .msg {
                padding: 8px 10px;
                border-radius: 6px;
                margin: 8px 0;
                background: #fff0c2
            }

            .ok {
                background: #d7f3e0
            }

            .err {
                background: #fbdcdc
            }

            .grid {
                display: grid;
                grid-template-columns: repeat(auto-fill,minmax(70px,1fr));
                gap: 5px
            }

            .sp {
                border-radius: 6px;
                padding: 5px;
                font-size: 11px;
                border: 1px solid #ccd;
                min-height: 46px
            }

            .f {
                background: #d7f3e0
            }

            .o {
                background: #fbdcdc
            }

            .v {
                background: #fff0c2
            }

            table {
                border-collapse: collapse;
                width: 100%;
                font-size: 13px
            }

            th, td {
                border-bottom: 1px solid #ddd;
                padding: 5px;
                text-align: left
            }

            .sc {
                overflow-x: auto
            }

            .text-danger {
                color: #c00;
                font-size: 13px
            }
    </style>
</head>
<body>
    <nav><a asp-controller="Parking" asp-action="Index">🅿️ Parking</a><a asp-controller="Vip" asp-action="Index">VIP clients</a></nav>
    <main>@RenderBody()</main>
</body>
</html>
