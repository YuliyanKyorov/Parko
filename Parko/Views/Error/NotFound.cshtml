@{
    ViewData["Title"] = "404 - Page not found";
}

<main class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <section class="card border-0 shadow-sm text-center">
            <div class="card-body p-4 p-lg-5">
                <p class="display-1 fw-bold text-primary mb-0">404</p>
                <h1 class="h3 mb-3">Page not found</h1>
                <p class="text-secondary">The page you requested could not be found or may have moved.</p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to home</a>
            </div>
        </section>
    </div>
</main>
