@*
    // This is the default error view used by the application.
*@
@{
    <div class="card">
        <h2>@ViewBag.Code – @ViewBag.Title</h2>
        <p>@ViewBag.Message</p>
        <p style="color:#667085;font-size:13px">Request code: @ViewBag.RequestId</p>
        <a asp-controller="Parking" asp-action="Index">← To the parking lot.</a>
    </div>
}
