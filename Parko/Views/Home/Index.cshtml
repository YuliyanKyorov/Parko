@model LoginViewModel
@{
    ViewData["Title"] = "Parko";
    ViewData["MainClass"] = "container-fluid p-0";
}

<section class="position-relative d-flex align-items-center min-vh-100 overflow-hidden bg-dark text-white">
    <img src="~/images/parking-hero.jpg" alt="" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"></div>

    <div class="container-fluid position-relative py-5">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-9">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-7 col-xl-6">
                        <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-body">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="bg-primary text-center py-1">
                                    <span class="fw-semibold text-white">Log in</span>
                                </div>
                                <div class="card-body p-3 p-md-4">
                                    <h1 class="h3 text-primary fw-bold mb-1">Hello, @User.Identity.Name!</h1>
                                    <p class="text-secondary mb-3">Welcome back to Parko.</p>
                                    <a asp-controller="Parking" asp-action="Index" class="btn btn-warning fw-semibold px-4">Go to parking</a>
                                </div>
                            }
                            else
                            {
                                <div class="bg-primary text-center py-1">
                                    <span class="fw-semibold text-white">Log in</span>
                                    <span class="text-white-50 px-2">|</span>
                                    <a asp-controller="Account" asp-action="Register" class="link-light text-decoration-none">Register</a>
                                </div>
                                <div class="card-body p-3 p-md-4">
                                    <h1 class="h3 text-primary fw-bold mb-1">Welcome to Parko</h1>
                                    <p class="text-secondary mb-3">Log in to continue.</p>
                                    <form asp-controller="Account" asp-action="Login" method="post">
                                        @if (!ViewData.ModelState.IsValid)
                                        {
                                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                                        }
                                        <div class="mb-2">
                                            <label asp-for="Login" class="form-label"></label>
                                            <input asp-for="Login" class="form-control" autocomplete="username" />
                                            <span asp-validation-for="Login" class="text-danger small"></span>
                                        </div>
                                        <div class="mb-2">
                                            <label asp-for="Password" class="form-label"></label>
                                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                            <span asp-validation-for="Password" class="text-danger small"></span>
                                        </div>
                                        <div class="form-check mb-3">
                                            <input asp-for="RememberMe" class="form-check-input" />
                                            <label asp-for="RememberMe" class="form-check-label"></label>
                                        </div>
                                        <button type="submit" class="btn btn-warning btn-sm fw-semibold px-3">Log in</button>
                                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm ms-2">Create an account</a>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row align-items-center mt-5">
                    <div class="col-auto">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-4 bg-primary p-3 fs-1" aria-hidden="true">🅿️🚘</span>
                    </div>
                    <div class="col">
                        <h2 class="display-5 fw-bold mb-0">Parking System</h2>
                        <p class="fs-5 text-white-50 mb-0">Easier parking. Better management.</p>
                    </div>
                </div>
            </div>

            <aside class="col-12 col-lg-3">
                <div class="rounded-4 bg-primary bg-opacity-75 p-3 p-xl-4 shadow">
                    <div class="d-grid gap-2" id="homeGuideMenu">
                        <div>
                            <button class="btn btn-outline-light w-100 text-start d-flex align-items-center gap-3"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#vehicleRegistrationGuide"
                                    aria-expanded="false" aria-controls="vehicleRegistrationGuide">
                                <span class="fs-3" aria-hidden="true">🚘</span>
                                <span class="fw-semibold">Vehicle registration</span>
                            </button>
                            <div class="collapse" id="vehicleRegistrationGuide" data-bs-parent="#homeGuideMenu">
                                <div class="rounded-3 bg-dark bg-opacity-25 p-3 mt-2 small">
                                    <ol class="mb-0 ps-3">
                                        <li>Select <strong>Register</strong> and complete the account form.</li>
                                        <li>Log in with your account.</li>
                                        <li>Open <strong>Parking spaces</strong>, choose an available space, enter your license plate and vehicle model, then select <strong>Park vehicle</strong>.</li>
                                    </ol>
                                    <p class="mb-0 mt-2">Administrators can register vehicles from the Admin dashboard.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-outline-light w-100 text-start d-flex align-items-center gap-3"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#parkingGuide"
                                    aria-expanded="false" aria-controls="parkingGuide">
                                <span class="fs-3" aria-hidden="true">🅿️</span>
                                <span class="fw-semibold">Parking space management</span>
                            </button>
                            <div class="collapse" id="parkingGuide" data-bs-parent="#homeGuideMenu">
                                <div class="rounded-3 bg-dark bg-opacity-25 p-3 mt-2 small">
                                    <p class="mb-2"><strong class="text-success">Green:</strong> available. <strong class="text-danger">Red:</strong> occupied. <strong class="text-warning">Yellow:</strong> VIP.</p>
                                    <p class="mb-0">Choose an available space to park. Occupied spaces cannot be selected.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-outline-light w-100 text-start d-flex align-items-center gap-3"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#timePriceGuide"
                                    aria-expanded="false" aria-controls="timePriceGuide">
                                <span class="fs-3" aria-hidden="true">⏱️</span>
                                <span class="fw-semibold">Time and price tracking</span>
                            </button>
                            <div class="collapse" id="timePriceGuide" data-bs-parent="#homeGuideMenu">
                                <div class="rounded-3 bg-dark bg-opacity-25 p-3 mt-2 small">
                                    <p class="mb-0">Parking time is measured from vehicle entry to check-out. The final price is calculated at check-out. Administrators can review entry time, exit time, duration, and price in the dashboard.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-outline-light w-100 text-start d-flex align-items-center gap-3"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#vipGuide"
                                    aria-expanded="false" aria-controls="vipGuide">
                                <span class="fs-3" aria-hidden="true">⭐</span>
                                <span class="fw-semibold">VIP cards and points</span>
                            </button>
                            <div class="collapse" id="vipGuide" data-bs-parent="#homeGuideMenu">
                                <div class="rounded-3 bg-dark bg-opacity-25 p-3 mt-2 small">
                                    <p class="mb-0">VIP vehicles are recognized by their registered license plate. VIP pricing applies automatically, and an available point can cover one parking stay.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-outline-light w-100 text-start d-flex align-items-center gap-3"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#securityGuide"
                                    aria-expanded="false" aria-controls="securityGuide">
                                <span class="fs-3" aria-hidden="true">🛡️</span>
                                <span class="fw-semibold">Security and control</span>
                            </button>
                            <div class="collapse" id="securityGuide" data-bs-parent="#homeGuideMenu">
                                <div class="rounded-3 bg-dark bg-opacity-25 p-3 mt-2 small">
                                    <p class="mb-0">If there is a problem, contact the parking operator on site or call <a class="link-light fw-semibold" href="tel:08777400">0877 7400</a>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
