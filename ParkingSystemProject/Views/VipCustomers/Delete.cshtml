@model ParkingSystemProject.Models.VipCustomer

@{
    ViewData["Title"] = "Delete VIP Customer";
}

<h1>Delete VIP Customer</h1>
<h3>Delete @Model.FirstName @Model.LastName?</h3>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>
